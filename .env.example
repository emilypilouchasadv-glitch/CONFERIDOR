# Chave da API da Anthropic (https://console.anthropic.com) - obrigatória
ANTHROPIC_API_KEY=sk-ant-...
# Modelo usado na análise (opcional). Padrão: claude-opus-5-5
# Mais barato: claude-sonnet-5-5 ou claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5
# Administrador criado automaticamente na primeira execução
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-esta-senha
# Porta (os serviços de hospedagem definem sozinhos)
PORT=3000
# Pasta onde o banco de dados (db.json) é salvo
DATA_DIR=./data
# Limites padrão para novos cadastros (0 = sem limite)
LIMITE_DIA_PADRAO=20
LIMITE_TOTAL_PADRAO=0
# Banco de dados gratuito (Neon/Supabase). Se preenchido, substitui o DATA_DIR.
DATABASE_URL=
# Teto de análises por dia somando todos os usuários (0 = sem teto). Padrão: 200
LIMITE_GLOBAL_DIA=200
# LGPD: nome e e-mail de quem responde pelos dados (aparecem na Política de Privacidade)
CONTROLADOR_NOME=Seu nome completo
CONTROLADOR_EMAIL=seu-email@exemplo.com
